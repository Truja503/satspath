namespace satspath{};

dictionary Identity {
    string pubkeyHex;
    string secretKeyPath;
    string fingerprint;
};

dictionary PaymentMethod {
    string type;
    string label;
    string network;
    string? address;
    string? lightningAddress;
    string? server;
    string? pubkey;
};

dictionary PaymentProfile {
    string alias;
    string identityPubkey;
    sequence<PaymentMethod> methods;
    i64 updatedAt;
    i64? expiresAt;
    u64? sequence;
    sequence<string> preferences;
    string? nonce;
};

dictionary SignedPaymentProfile {
    PaymentProfile profile;
    string signature;
};

dictionary QuoteRequest {
    string recipient;
    u64 amountSats;
    SignedPaymentProfile signedProfile;
    string urgency;
    u64? maxFeeSats;
    f64? maxFeePercent;
};

dictionary RouteQuote {
    PaymentMethod selectedMethod;
    u64 estimatedFeeSats;
    string estimatedConfirmation;
    string reason;
    string execution;
    string walletHint;
};

dictionary FeeEstimate {
    u64 fastestFee;
    u64 halfHourFee;
    u64 hourFee;
    u64 economyFee;
    u64 minimumFee;
};

dictionary QuoteRecipient {
    string alias;
    boolean verified;
    boolean profileSignatureVerified;
    boolean identifierVerified;
    string identifierVerification;
    string fingerprint;
};

dictionary Invite {
    string aliasHash;
    u64 amountSats;
    i64 createdAt;
    i64 expiresAt;
    string claimUrl;
    string warning;
    string? senderSignature;
    string? senderPubkey;
};

dictionary QuoteResponse {
    QuoteRecipient? recipient;
    PaymentMethod? selectedMethod;
    u64? feeSats;
    string? eta;
    string? reason;
    string? qr;
    string? execution;
    string? walletHint;
    Invite? invite;
};

dictionary QuoteRecipient {
    string alias;
    boolean verified;
    boolean profileSignatureVerified;
    boolean identifierVerified;
    string identifierVerification;
    string fingerprint;
};

interface ProfileResolver {
    [Async] SignedPaymentProfile resolveAlias(string alias);
};

interface Router {
    [Async] RouteQuote selectRoute(QuoteRequest request, FeeEstimate fees);
    [Async] FeeEstimate fetchFeeEstimate();
    string buildQrPayload(PaymentMethod method, u64 amountSats);
};

interface Satspath {
    [Async] QuoteResponse quote(string recipient, u64 amountSats);
    [Async] SignedPaymentProfile resolve(string alias);
    boolean verifyProfile(SignedPaymentProfile profile);
    [Async] RouteQuote route(QuoteRequest request);
    [Async] Identity createIdentity();
    [Async] void saveProfile(SignedPaymentProfile profile);
    [Async] SignedPaymentProfile? loadProfile(string alias);
    [Async] void startP2pBridge(string profilePath);
    void stopP2pBridge();
};

interface ResolverChain {
    [Async] SignedPaymentProfile resolveAlias(string alias);
};